# Configuración del Servidor
PORT=3000
NODE_ENV=development

# MySQL. Copia este archivo a .env y usa tus valores locales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_eventos
DB_PASSWORD=contraseña_de_ejemplo_reemplazar
DB_NAME=eventos
DB_TEST_NAME=eventos_auditoria_test

# En producción: origen HTTPS exacto del frontend, separado por comas si hay varios.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

